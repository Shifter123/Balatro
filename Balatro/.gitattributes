# Git LFS configuration for Balatro

# Track large binary files with Git LFS
assets/images/**/*.{png,jpg,jpeg,gif,bmp,webp,tga,svg} filter=lfs diff=lfs merge=lfs -text
assets/audio/**/*.{wav,mp3,ogg,flac} filter=lfs diff=lfs merge=lfs -text
assets/fonts/**/*.{ttf,otf,woff,woff2} filter=lfs diff=lfs merge=lfs -text

# Export templates
export_templates/**/* filter=lfs diff=lfs merge=lfs -text

# Third-party libraries (if any binary dependencies)
lib/**/* filter=lfs diff=lfs merge=lfs -text

# Documentation images (optional large files)
docs/images/**/* filter=lfs diff=lfs merge=lfs -text

# Configuration for non-text files
*.tres text
*.tscn text
*.godot text
*.json text
*.md text
*.yaml text
*.yml text
*.cfg text
*.ini text
*.toml text
